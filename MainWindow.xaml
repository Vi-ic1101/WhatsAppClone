<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppClone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhatsAppClone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WhatsAppClone">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="BlanchedAlmond">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#202C33" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="0"
                Spacing="12"
                Padding="10"
                HorizontalAlignment="Center">

                <Button Width="46"
                        Height="46"
                        CornerRadius="23"
                        Background="#374951"
                        BorderThickness="3"
                        Content="&#xE77B;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        ToolTipService.ToolTip="Profile"/>

                <Button 
                    Width="46"
                    Height="46"
                    Background="#374951"
                    BorderThickness="3"
                    CornerRadius="23"
                    Content="&#xE8BD;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    ToolTipService.ToolTip="Chats"/>


                <Button 
                     Width="46"
                     Height="46"
                     Background="Transparent"
                     BorderThickness="3"
                     CornerRadius="23"
                     Content="&#xF138;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="21"
                     ToolTipService.ToolTip="Chats"/>

                <Button 
                     Width="46"
                     Height="46"
                     Background="Transparent"
                     BorderThickness="3"
                     CornerRadius="23"
                     Content="&#xE902;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="20"
                     ToolTipService.ToolTip="Communities"/>

                <Button 
                     Width="46"
                     Height="46"
                     Background="Transparent"
                     BorderThickness="3"
                     CornerRadius="23"
                     Content="&#xE789;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="18"
                     ToolTipService.ToolTip="Channels"/>

                <Button 
                     Width="46"
                     Height="46"
                     Background="Transparent"
                     BorderThickness="3"
                     CornerRadius="23"
                     Content="&#xE717;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="20"
                     ToolTipService.ToolTip="Calls"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Spacing="12"
                        Padding="10"
                        HorizontalAlignment="Center">

                <Button 
                     Width="46"
                     Height="46"
                     Background="Transparent"
                     BorderThickness="3"
                     CornerRadius="23"
                     Content="&#xE713;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="18"
                     ToolTipService.ToolTip="Settings"/>


                <Button
                    Width="46"
                    Height="46"
                    CornerRadius="23"
                    Background="#52636C"
                    BorderThickness="0"
                    Content="&#xEA8C;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    ToolTipService.ToolTip="My Account"/>

            </StackPanel>
        </Grid>
        
        <Grid Grid.Column="1" Background="#FFFFFF" >

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            
            <!-- header part -->
            <Grid Grid.Row="0"
                  Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Chats"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#111B21"
                    VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Button
                        Content="✎"
                        FontSize="20"
                        Background="Black"
                        BorderThickness="2"
                        ToolTipService.ToolTip="New chat"/>

                    <Button
                        Content="⋮"
                        FontSize="23"
                        Background="Beige"
                        BorderThickness="2"
                        ToolTipService.ToolTip="Menu"/> 
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="2" Background="#EFEAE2">

        </Grid>

    </Grid>
</Window>
