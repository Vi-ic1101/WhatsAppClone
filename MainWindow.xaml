<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppClone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhatsAppClone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WhatsAppClone">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="BlanchedAlmond">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#202C33" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="0"
                Spacing="12"
                Padding="10"
                HorizontalAlignment="Center">

                <Button Width="46"
                        Height="46"
                        CornerRadius="23"
                        Background="#374951"
                        BorderThickness="0"
                        Content="&#xE77B;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        ToolTipService.ToolTip="Profile"/>

                <Button 
                    Width="46"
                    Height="46"
                    Background="#374951"
                    BorderThickness="0"
                    CornerRadius="23"
                    Content="&#xE8BD;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="21"
                    ToolTipService.ToolTip="Chats"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Column="1" Background="#FFFFFF" >

        </Grid>

        <Grid Grid.Column="2" Background="#EFEAE2">

        </Grid>

    </Grid>
</Window>
